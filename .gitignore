# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# atlas-v3:gitignore:start
.claude/worktrees/
.claude/atlas-state/
# Test evidence stays committable even where a team rule would ignore it.
# Both lines are needed: the first re-includes the directory (git will not
# descend into an ignored one), the second re-includes what is inside it.
# Neither can help if an ANCESTOR directory is ignored; git cannot
# re-include anything under an excluded parent.
!test-results/
!test-results/**
# atlas-v3:gitignore:end

# Local-only logs and captured artifacts
/test-logs.txt
/smoke-logs.txt
/screenshots/
scripts/broken-links-*.csv
scripts/malformed-paths-*.csv
node_modules/
